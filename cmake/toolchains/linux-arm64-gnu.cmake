set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if(NOT DEFINED ENV{PEARE_ARM64_SYSROOT} OR "$ENV{PEARE_ARM64_SYSROOT}" STREQUAL "")
    message(FATAL_ERROR "PEARE_ARM64_SYSROOT is not set")
endif()

set(CMAKE_SYSROOT "$ENV{PEARE_ARM64_SYSROOT}")
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc CACHE FILEPATH "ARM64 C compiler")
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++ CACHE FILEPATH "ARM64 C++ compiler")
set(CMAKE_AR aarch64-linux-gnu-ar CACHE FILEPATH "ARM64 archiver")
set(CMAKE_RANLIB aarch64-linux-gnu-ranlib CACHE FILEPATH "ARM64 ranlib")
set(CMAKE_STRIP aarch64-linux-gnu-strip CACHE FILEPATH "ARM64 strip")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH "$ENV{QT5_ROOT_ARM64}" "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
